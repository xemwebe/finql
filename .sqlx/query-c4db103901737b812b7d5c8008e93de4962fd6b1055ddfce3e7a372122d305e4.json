{
  "db_name": "PostgreSQL",
  "query": "SELECT\n                a.id as \"id!\",\n                a.asset_class as \"asset_class!\",\n                CASE\n                    WHEN a.asset_class='currency' THEN c.iso_code\n                    ELSE s.name\n                END as \"name!\",\n                s.wkn,\n                s.isin,\n                s.note\n            FROM\n                assets a\n                LEFT JOIN stocks s ON a.id = s.id\n                LEFT JOIN currencies c ON a.id = c.id",
